#!/bin/bash
# Redeploy atrt-thess when ghcr.io/angelospk/athens-transit-rt:latest has a new digest.
# The OASTH salt stays in /etc/atrt-thess.env (root, 600); never echo it.
# Installed as /usr/local/bin/atrt-thess-deploy; the common part is /usr/local/lib/atrt-deploy-common.sh (#185).
set -euo pipefail
. /usr/local/lib/atrt-deploy-common.sh
NAME=atrt-thess
deploy_lock
host_check
old=$(docker inspect --format '{{.Image}}' "$NAME" 2>/dev/null || true)
pull
new=$(docker image inspect --format '{{.Id}}' "$IMG")
rev=$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$IMG")
if [ "$old" = "$new" ] && docker ps -q -f name="^${NAME}$" | grep -q .; then
  echo "up to date: $NAME on rev $rev"
  exit 0
fi
if [ "${DRY_RUN:-}" = 1 ]; then echo "dry run: would deploy $NAME (rev $rev)"; exit 0; fi
echo "deploying $NAME (rev $rev)"
[ -n "$old" ] && docker tag "$old" atrt-thess:previous || true
docker rm -f "$NAME" >/dev/null 2>&1 || true
docker run -d --name "$NAME" --restart unless-stopped --network host \
  --env-file /etc/atrt-thess.env --memory 300m --memory-swap 450m --read-only \
  --security-opt no-new-privileges:true --cap-drop ALL --log-driver journald \
  -v atrt-thess-state:/var/lib/atrt "$IMG" \
  serve --city thessaloniki --rps "$(cat /etc/atrt-thess.rps 2>/dev/null || echo 1)" --history \
  --listen 127.0.0.1:8098 --metrics-listen 127.0.0.1:8099 --state /var/lib/atrt >/dev/null
for i in $(seq 1 24); do
  sleep 5
  if out=$(curl -fsS --max-time 5 127.0.0.1:8098/v1/status); then echo "ok: $out"; exit 0; fi
done
echo "health check failed for $NAME (rev $rev)" >&2
exit 1
